# KYC Guardian AI - Environment Configuration
# Copy this file to .env and adjust values as needed

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=sqlite:///./kyc_guardian.db
DATABASE_ECHO=false

# ============================================================================
# Document Storage
# ============================================================================
DOCUMENT_STORAGE_PATH=./storage/documents
TEMP_UPLOAD_PATH=./storage/temp
DEMO_DATA_PATH=./demo-data/generated

# ============================================================================
# File Upload Configuration
# ============================================================================
MAX_UPLOAD_SIZE_MB=50
MAX_TOTAL_CASE_SIZE_MB=500
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg

# ============================================================================
# OCR Configuration
# ============================================================================
OCR_ENGINE=tesseract
TESACT_PATH=/usr/bin/tesseract
OCR_LANGUAGE=eng
OCR_CONFIDENCE_THRESHOLD=0.5

# ============================================================================
# AI Service Configuration
# ============================================================================
# Options: 'mock' (default, no internet required) or 'ollama'
AI_SERVICE=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_ENABLED=false

# ============================================================================
# Extraction & Validation Thresholds (Demo Configuration)
# ============================================================================
# High confidence extraction threshold
HIGH_CONFIDENCE_THRESHOLD=0.90
# Medium confidence extraction threshold
MEDIUM_CONFIDENCE_THRESHOLD=0.70
# Address similarity threshold for comparison
ADDRESS_SIMILARITY_THRESHOLD=0.85
# Document expiry warning days
DOCUMENT_EXPIRY_WARNING_DAYS=90

# ============================================================================
# Masking Configuration
# ============================================================================
ENABLE_PII_MASKING=true
MASK_NAMES=true
MASK_PHONE_NUMBERS=true
MASK_EMAIL_ADDRESSES=true
MASK_IDENTITY_NUMBERS=true
MASK_TAX_IDENTIFIERS=true
MASK_ACCOUNT_NUMBERS=true
MASK_ADDRESSES=true
MASK_DATES_OF_BIRTH=true

# ============================================================================
# Demo & Testing Configuration
# ============================================================================
ENABLE_MOCK_DATA=true
ENABLE_DEMO_RESET=true
ENABLE_SYNTHETIC_ANALYTICS=true
DEMO_NOTICE_TEXT=Synthetic demonstration data only. Do not upload customer, colleague, proprietary, restricted or regulated information.

# ============================================================================
# Security Configuration
# ============================================================================
LOG_SENSITIVE_DATA=false
ENABLE_PROMPT_INJECTION_DETECTION=true
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_RETENTION_DAYS=365

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/kyc-guardian.log

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_CROSS_DOCUMENT_COMPARISON=true
FEATURE_EXCEPTION_MANAGEMENT=true
FEATURE_EVIDENCE_PACK_EXPORT=true
FEATURE_ANALYTICS_DASHBOARD=true
FEATURE_AUDIT_TRAIL=true
